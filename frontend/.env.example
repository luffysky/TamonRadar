# ===== TamonRadar 前端環境變數範本 =====
# 複製成 .env.local(本機)或在 Zeabur 的環境變數設定填入。
#
# 後端 API 的網址。注意:NEXT_PUBLIC_ 開頭的變數是「建置時」寫死進前端的,
# 所以在 Zeabur 設定後需要重新部署一次才會生效。
#
# 本機開發:
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# 部署後改成你的後端網域,例如:
# NEXT_PUBLIC_API_BASE=https://tamonradar-api.zeabur.app

# 本站自己的公開網址(SEO / sitemap / OG 用),填前端網域:
NEXT_PUBLIC_SITE_URL=https://tamonradar.snowrealm.pet

# Giphy GIF / 貼圖選擇器(部落格/討論區編輯器用,選用):
# 到 https://developers.giphy.com 申請,沒設就只是不能插入 GIF/貼圖
NEXT_PUBLIC_GIPHY_API_KEY=
