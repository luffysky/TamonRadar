# ===== TamonRadar 後端環境變數範本 =====
# 複製成 .env(本機)或在 Vercel 的環境變數設定填入。

# ---- 資料庫 ----
# Supabase / Postgres 連線字串。雲端務必設定;留空會用本機 SQLite(僅本機開發)。
# 從 Supabase 服務頁複製,例:postgresql://postgres:密碼@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# ---- 執行環境 ----
# production = 正式環境:JWT_SECRET / ENCRYPTION_KEY 缺少、仍是預設值或兩者相同時,後端拒絕啟動。
# 沒設 APP_ENV 時,只要 DATABASE_URL 指向 Postgres 也視為正式環境;本機開發請設 development。
APP_ENV=production

# ---- 帳號 / 安全 ----
# JWT 簽章密鑰,請自己亂打一長串。雲端一定要設,否則所有人的 token 都能偽造。
JWT_SECRET=
# 管理員 email(逗號分隔),這些帳號能看 /admin 後台
ADMIN_EMAILS=admin@example.com
# 擁有者(超級管理員,逗號分隔):只有這些人能給特權/停權。留空則所有管理員都是擁有者
OWNER_EMAILS=owner@example.com
# 上面兩個名單的帳號還必須「已驗證 email」(或用 Google 登入)才有權限,避免有人搶先註冊管理員 email。
# 既有帳號若收不到驗證信,可把 tr_users.id 填在這裡直接放行(逗號分隔,數字 id)。
ADMIN_TRUSTED_USER_IDS=
# 限流用的真實來源 IP 標頭:有過 Cloudflare 就填 cf-connecting-ip;留空用 X-Forwarded-For 最右邊一段
TRUSTED_IP_HEADER=
# 敏感設定(使用者 AI 金鑰、Discord/TG 憑證)加密用的密鑰。
# 正式環境必填,且不可與 JWT_SECRET 相同。換金鑰時把舊值放到 ENCRYPTION_KEY_PREVIOUS,舊資料才解得開。
ENCRYPTION_KEY=
# 換金鑰用:舊的 ENCRYPTION_KEY(逗號分隔可放多個);若舊資料是用 JWT_SECRET 衍生的,就填舊的 JWT_SECRET。
ENCRYPTION_KEY_PREVIOUS=
# 同時最多幾個爬蟲一起跑(避免多人同時用爆記憶體)
MAX_CONCURRENT_CRAWLS=5
# 免費使用者每日額度(特權/付費/管理員不受限)
FREE_AI_DAILY=30
FREE_SEARCH_DAILY=15
# AI 花費保護:免費使用者每分鐘 AI 次數、每日封面生成張數;Telegram/Discord 機器人每人每小時與全站每日上限
FREE_AI_PER_MINUTE=10
FREE_IMAGE_DAILY=3
BOT_AI_PER_HOUR=20
BOT_AI_DAILY=300


# ---- 搜尋 API(取代 Google Selenium,雲端強烈建議設定)----
# 搜尋來源:brave | serpapi | selenium。留空 = 自動(優先 SerpAPI)。
# 執行時若 SerpAPI 額度用完會「自動 fallback 到 Brave」,所以兩個金鑰都建議填。
SEARCH_PROVIDER=
# Brave Search API 金鑰(免費額度大):https://brave.com/search/api/
BRAVE_API_KEY=
# SerpAPI 金鑰:https://serpapi.com/
SERPAPI_KEY=
# Serper.dev(Google 結果,註冊送額度):https://serper.dev
SERPER_API_KEY=
# Google 自訂搜尋 CSE(每天免費 100):需 API key + 搜尋引擎 ID(cx)
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# Tavily(AI 搜尋,免費 1000/月):https://tavily.com
TAVILY_API_KEY=
# SearXNG 自架實例網址(開源、免金鑰、雲端不被擋),例:https://searx.yourdomain.com
SEARXNG_URL=
# DuckDuckGo 免金鑰、開源套件 ddgs,無需設定(雲端 IP 可能被限流)
# 雲端沒裝 Chromium 時設 1:完全不開瀏覽器(只用搜尋 API),避免 chromedriver 啟動失敗(status 127)
# 輕量 Dockerfile 已預設 =1;本機要用 Selenium 進詳細頁就別設或設 0
DISABLE_BROWSER=1
# 手動禁止爬取的網域(逗號分隔);預設不封鎖任何站,一律以各站 robots.txt 為準
BLOCKED_DOMAINS=
# Web Push 系統通知(關站也收得到):VAPID 金鑰。產生:pip install py-vapid && vapid --gen
# 公鑰也要填到「前端」NEXT_PUBLIC… 不需要,前端是跟後端 /api/push/key 拿。沒設則停用推播。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- AI(摘要 / 對話 / 濾雜訊)----
# 預設先用 GPT(OpenAI);沒設 OpenAI 才用 Claude。可用 AI_PROVIDER 強制指定。
# AI_PROVIDER = openai | gemini | groq | openrouter | anthropic(留空 = 自動,先 GPT)
AI_PROVIDER=
# OpenAI(GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini(走 OpenAI 相容端點)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Groq(超快推論)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter(一把鑰匙串接多家模型)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Anthropic(Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ---- Google 第三方登入(選用)----
# 到 https://console.cloud.google.com/ 建立 OAuth 用戶端(類型:Web)。
# 授權重新導向 URI 要填:<後端網址>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 後端對外網址(給 OAuth 組 callback 用);本機可留空,會自動用請求網址。
# 例:https://tamonradar-backend.snowrealm.pet
OAUTH_REDIRECT_BASE=
# 登入成功後要轉址回的前端網址;留空會用 CORS_ORIGINS 的第一個。
# 例:https://tamonradar.snowrealm.pet
FRONTEND_URL=

# ---- 寄信(忘記密碼 / 驗證信用)----
# 先用 Resend,額度用完 / 失敗自動換 Gmail SMTP。
# Resend:https://resend.com 申請,免費 3000 封/月
RESEND_API_KEY=
# 寄件者(用 Resend 測試可填 onboarding@resend.dev;正式建議用驗證過的網域)
RESEND_FROM=TamonRadar <onboarding@resend.dev>
# Gmail SMTP(備援):需開兩步驟驗證後產生「應用程式密碼」
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Gmail 寄件顯示(可不填,預設用 GMAIL_USER)
MAIL_FROM=

# ---- AI 機器人(讓使用者在 Telegram/Discord 跟 AI 對話,選用)----
# Telegram:跟 @BotFather 建 bot 拿 token;WEBHOOK_SECRET 自己取一長串隨機字串(沒設 = webhook 一律拒絕)。
# 設好後到 /admin 按「設定 Telegram webhook」即可開通。
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Discord:Developer Portal 建 application。
# DISCORD_PUBLIC_KEY 用來驗證 interactions;Interactions Endpoint URL 填
#   <後端網址>/api/discord/interactions;再到 /admin 按「註冊 Discord 指令」。
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
# 社群邀請連結(/api/go/discord、/api/go/telegram 轉址用;藏在後端,只在登入後設定頁露出)
DISCORD_INVITE_URL=https://discord.gg/yMVZNZE8W
TELEGRAM_BOT_URL=https://t.me/TamonRadarsBot

# ---- Cloudflare R2 檔案上傳(部落格/討論區附圖/影片/音樂,選用)----
# 1. Cloudflare → R2 建 bucket;2. 開 Public access 拿 pub-xxx.r2.dev 網址;
# 3. R2 → Manage API tokens 建讀寫 token。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_URL=https://pub-xxxxxxxx.r2.dev

# ---- 幣別換算(價格雷達用,選用;不設用預設約略匯率)----
TWD_PER_JPY=0.22
TWD_PER_USD=32
TWD_PER_CNY=4.4

# ---- CORS ----
# 允許跨來源請求的「前端」網址(逗號分隔)。注意:要填前端網域,不是後端!
# 結尾不用加斜線(後端會自動去掉)。例:
# CORS_ORIGINS=https://tamonradar.snowrealm.pet,http://localhost:3000
CORS_ORIGINS=https://tamonradar.snowrealm.pet
# 平台共用 Discord 頻道 webhook(沒設個人通知者的 fallback,選用)
DISCORD_WEBHOOK=

# 整站爬安全上限頁數(付費/特權帳號適用,預設 5000;免費帳號上限見 backend/quota.py)
SITE_MAX_PAGES_CAP=5000

# ---- Vercel / 無狀態工作者 ----
# 內部端點(cron、工作者)的 Bearer;沒設一律拒絕
CRON_SECRET=
# Neon 直連,只有 migrate.py / 匯入腳本使用(DATABASE_URL 用 pooled)
DATABASE_URL_UNPOOLED=
# 工作者每輪時間預算(秒)、心跳逾時(秒)
# WORKER_BUDGET_SECONDS=240
# JOB_STALE_SECONDS=180
# 自我觸發的網址;預設用 VERCEL_PROJECT_PRODUCTION_URL
# WORKER_TRIGGER_BASE=
# 事件/工作/系統工作/價格觀測保留天數
# JOB_EVENT_RETENTION_DAYS=7
# JOB_RETENTION_DAYS=30
# SYSTEM_JOB_RETENTION_DAYS=3
# PRICE_OBSERVATION_RETENTION_DAYS=365
# 應用層連線池:0=NullPool
# DB_POOL_SIZE=1
# DB_MAX_OVERFLOW=4
