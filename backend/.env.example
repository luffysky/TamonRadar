# ===== TamonRadar 後端環境變數範本 =====
# 複製成 .env(本機)或在 Zeabur 的環境變數設定填入。

# ---- 資料庫 ----
# Supabase / Postgres 連線字串。雲端務必設定;留空會用本機 SQLite(僅本機開發)。
# 從 Supabase 服務頁複製,例:postgresql://postgres:密碼@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# ---- 帳號 / 安全 ----
# JWT 簽章密鑰,請自己亂打一長串。雲端一定要設,否則所有人的 token 都能偽造。
JWT_SECRET=
# 同時最多幾個爬蟲一起跑(避免多人同時用爆記憶體)
MAX_CONCURRENT_CRAWLS=2


# ---- 搜尋 API(取代 Google Selenium,雲端強烈建議設定)----
# 搜尋來源:brave | serpapi | selenium。留空會自動依下面有設哪個金鑰決定。
SEARCH_PROVIDER=
# Brave Search API 金鑰(免費額度大):https://brave.com/search/api/
BRAVE_API_KEY=
# SerpAPI 金鑰:https://serpapi.com/
SERPAPI_KEY=

# Claude AI 摘要功能(選用)。不設定的話 AI 摘要會停用,其他功能正常。
ANTHROPIC_API_KEY=
# 摘要使用的模型,可不改
CLAUDE_MODEL=claude-sonnet-4-6

# 允許跨來源請求的前端網址(逗號分隔)。
# 本機開發用預設即可;部署後請改成你的前端網域,例如:
# CORS_ORIGINS=https://tamonradar.zeabur.app
CORS_ORIGINS=https://tamonradar-backend.snowrealm.pet/
