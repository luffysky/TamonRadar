# ===== TamonRadar 後端環境變數範本 =====
# 複製成 .env(本機)或在 Zeabur 的環境變數設定填入。

# Claude AI 摘要功能(選用)。不設定的話 AI 摘要會停用,其他功能正常。
ANTHROPIC_API_KEY=
# 摘要使用的模型,可不改
CLAUDE_MODEL=claude-sonnet-4-6

# 允許跨來源請求的前端網址(逗號分隔)。
# 本機開發用預設即可;部署後請改成你的前端網域,例如:
# CORS_ORIGINS=https://tamonradar.zeabur.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
