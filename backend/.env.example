# ===== TamonRadar 後端環境變數範本 =====
# 複製成 .env(本機)或在 Zeabur 的環境變數設定填入。

# ---- 資料庫 ----
# Supabase / Postgres 連線字串。雲端務必設定;留空會用本機 SQLite(僅本機開發)。
# 從 Supabase 服務頁複製,例:postgresql://postgres:密碼@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# ---- 帳號 / 安全 ----
# JWT 簽章密鑰,請自己亂打一長串。雲端一定要設,否則所有人的 token 都能偽造。
JWT_SECRET=
# 管理員 email(逗號分隔),這些帳號能看 /admin 後台
ADMIN_EMAILS=luffysky00@gmail.com
# 敏感設定(使用者 AI 金鑰、Discord/TG 憑證)加密用的密鑰。
# 留空會用 JWT_SECRET 衍生;正式建議獨立設一長串。換掉會讓舊加密資料無法解密。
ENCRYPTION_KEY=
# 同時最多幾個爬蟲一起跑(避免多人同時用爆記憶體)
MAX_CONCURRENT_CRAWLS=2
# 免費使用者每日額度(特權/付費/管理員不受限)
FREE_AI_DAILY=30
FREE_SEARCH_DAILY=15


# ---- 搜尋 API(取代 Google Selenium,雲端強烈建議設定)----
# 搜尋來源:brave | serpapi | selenium。留空 = 自動(優先 SerpAPI)。
# 執行時若 SerpAPI 額度用完會「自動 fallback 到 Brave」,所以兩個金鑰都建議填。
SEARCH_PROVIDER=
# Brave Search API 金鑰(免費額度大):https://brave.com/search/api/
BRAVE_API_KEY=
# SerpAPI 金鑰:https://serpapi.com/
SERPAPI_KEY=
# Serper.dev(Google 結果,註冊送額度):https://serper.dev
SERPER_API_KEY=
# Google 自訂搜尋 CSE(每天免費 100):需 API key + 搜尋引擎 ID(cx)
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# Tavily(AI 搜尋,免費 1000/月):https://tavily.com
TAVILY_API_KEY=
# SearXNG 自架實例網址(開源、免金鑰、雲端不被擋),例:https://searx.yourdomain.com
SEARXNG_URL=
# DuckDuckGo 免金鑰、開源套件 ddgs,無需設定(雲端 IP 可能被限流)
# 雲端沒裝 Chromium 時設 1:完全不開瀏覽器(只用搜尋 API),避免 chromedriver 啟動失敗(status 127)
# 輕量 Dockerfile 已預設 =1;本機要用 Selenium 進詳細頁就別設或設 0
DISABLE_BROWSER=1

# ---- AI(摘要 / 對話 / 濾雜訊)----
# 預設先用 GPT(OpenAI);沒設 OpenAI 才用 Claude。可用 AI_PROVIDER 強制指定。
# AI_PROVIDER = openai | gemini | groq | openrouter | anthropic(留空 = 自動,先 GPT)
AI_PROVIDER=
# OpenAI(GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini(走 OpenAI 相容端點)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Groq(超快推論)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter(一把鑰匙串接多家模型)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Anthropic(Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ---- Google 第三方登入(選用)----
# 到 https://console.cloud.google.com/ 建立 OAuth 用戶端(類型:Web)。
# 授權重新導向 URI 要填:<後端網址>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 後端對外網址(給 OAuth 組 callback 用);本機可留空,會自動用請求網址。
# 例:https://tamonradar-backend.snowrealm.pet
OAUTH_REDIRECT_BASE=
# 登入成功後要轉址回的前端網址;留空會用 CORS_ORIGINS 的第一個。
# 例:https://tamonradar.snowrealm.pet
FRONTEND_URL=

# ---- 寄信(忘記密碼 / 驗證信用)----
# 先用 Resend,額度用完 / 失敗自動換 Gmail SMTP。
# Resend:https://resend.com 申請,免費 3000 封/月
RESEND_API_KEY=
# 寄件者(用 Resend 測試可填 onboarding@resend.dev;正式建議用驗證過的網域)
RESEND_FROM=TamonRadar <onboarding@resend.dev>
# Gmail SMTP(備援):需開兩步驟驗證後產生「應用程式密碼」
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Gmail 寄件顯示(可不填,預設用 GMAIL_USER)
MAIL_FROM=

# ---- AI 機器人(讓使用者在 Telegram/Discord 跟 AI 對話,選用)----
# Telegram:跟 @BotFather 建 bot 拿 token;WEBHOOK_SECRET 自己取一個字串。
# 設好後到 /admin 按「設定 Telegram webhook」即可開通。
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=tamon-secret
# Discord:Developer Portal 建 application。
# DISCORD_PUBLIC_KEY 用來驗證 interactions;Interactions Endpoint URL 填
#   <後端網址>/api/discord/interactions;再到 /admin 按「註冊 Discord 指令」。
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=

# ---- Cloudflare R2 檔案上傳(部落格/討論區附圖/影片/音樂,選用)----
# 1. Cloudflare → R2 建 bucket;2. 開 Public access 拿 pub-xxx.r2.dev 網址;
# 3. R2 → Manage API tokens 建讀寫 token。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_URL=https://pub-xxxxxxxx.r2.dev

# ---- 幣別換算(價格雷達用,選用;不設用預設約略匯率)----
TWD_PER_JPY=0.22
TWD_PER_USD=32
TWD_PER_CNY=4.4

# ---- CORS ----
# 允許跨來源請求的「前端」網址(逗號分隔)。注意:要填前端網域,不是後端!
# 結尾不用加斜線(後端會自動去掉)。例:
# CORS_ORIGINS=https://tamonradar.snowrealm.pet,http://localhost:3000
CORS_ORIGINS=https://tamonradar-backend.snowrealm.pet/
